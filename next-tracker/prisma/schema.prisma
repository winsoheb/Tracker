generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH & USERS
// ==========================================

// Enums replaced with strings for SQLite support
// Role: ADMIN, MANAGER, EMPLOYEE

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  avatar         String?
  timezone       String          @default("UTC")
  
  // Auth Fields
  passwordHash   String?         // For Local Auth
  microsoftId    String?         @unique // For Microsoft SSO
  role           String          @default("EMPLOYEE")
  isActive       Boolean         @default(true)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Organization Relations
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamMemberships TeamMember[]

  // App Relations
  categories     Category[]
  projects       Project[]
  timeEntries    TimeEntry[]
  runningTimers  RunningTimer[]
  breaks         Break[]
  shifts         Shift[]
  tasks          Task[]
  settings       Setting?
  activityEvents ActivityEvent[]
  auditLogs      AuditLog[]
  timeOffs       TimeOff[]
}

// ==========================================
// ORGANIZATION
// ==========================================

model Organization {
  id          String       @id @default(uuid())
  name        String
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  teams          Team[]
  users          User[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Team {
  id           String       @id @default(uuid())
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  members      TeamMember[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model TeamMember {
  userId    String
  teamId    String
  isManager Boolean  @default(false)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
}

// ==========================================
// CORE DOMAIN (Projects & Categories)
// ==========================================

model Category {
  id             String          @id @default(uuid())
  userId         String
  name           String
  description    String?
  icon           String?
  color          String?
  hourlyGoal     Int?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]
  timeEntries    TimeEntry[]
  tasks          Task[]
  runningTimers  RunningTimer[]

  @@index([userId])
}

model Project {
  id             String          @id @default(uuid())
  userId         String
  name           String
  description    String?
  categoryId     String?
  color          String?
  status         String          @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, ARCHIVED
  health         String          @default("ON_TRACK") // ON_TRACK, AT_RISK, CRITICAL
  progress       Float           @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  timeEntries    TimeEntry[]
  tasks          Task[]
  runningTimers  RunningTimer[]
  
  phases         ProjectPhase[]
  milestones     ProjectMilestone[]
  risks          ProjectRisk[]
  issues         ProjectIssue[]
  decisions      ProjectDecision[]
  dependencies   ProjectDependency[]
  changeLogs     ProjectChangeLog[]
  documents      ProjectDocument[]

  @@index([userId])
}

// ==========================================
// TIME TRACKING
// ==========================================

model TimeEntry {
  id             String          @id @default(uuid())
  userId         String
  projectId      String?
  categoryId     String?
  taskId         String?
  title          String
  description    String?
  startedAt      DateTime
  endedAt        DateTime
  duration       Int             // duration in seconds
  source         String          // TIMER, MANUAL, PLANNER
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  task           Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([taskId])
  @@index([projectId])
  @@index([categoryId])
}

model RunningTimer {
  id                  String          @id @default(uuid())
  userId              String
  projectId           String?
  categoryId          String?
  taskId              String?
  title               String
  description         String?
  startedAt           DateTime
  pausedAt            DateTime?
  accumulatedDuration Int             @default(0) // seconds accumulated before current resume
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category            Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  task                Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model Break {
  id             String          @id @default(uuid())
  userId         String
  type           String          // Lunch, Short break, Tea, Personal, Other
  startedAt      DateTime
  endedAt        DateTime?
  duration       Int?            // seconds
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shift {
  id              String          @id @default(uuid())
  userId          String
  date            DateTime        // Date only
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  expectedMinutes Int?
  workedMinutes   Int?
  breakMinutes    Int?
  overtimeMinutes Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// PLANNER & TASKS (V2 Redesign)
// ==========================================

// TaskStatus: TODO, IN_PROGRESS, BLOCKED, COMPLETED, CANCELLED
// TaskPriority: LOW, MEDIUM, HIGH, URGENT

model Task {
  id               String          @id @default(uuid())
  userId           String
  projectId        String?
  phaseId          String?
  categoryId       String?
  title            String
  description      String?
  
  // V2 Advanced Fields
  status           String      @default("TODO")
  statusReason     String?
  priority         String    @default("MEDIUM")
  
  startAt          DateTime?
  endAt            DateTime?
  dueDate          DateTime?
  estimatedMinutes Int?
  
  color            String?
  completedAt      DateTime?
  
  // Recurrence
  recurrenceId     String?
  recurrence       TaskRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  originalStartAt  DateTime?       // Used to identify which occurrence this overrides
  isSkipped        Boolean         @default(false)
  isBlueprint      Boolean         @default(false) // If true, this task acts as the template for future occurrences

  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  phase            ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  timeEntries      TimeEntry[]
  runningTimers    RunningTimer[]
  reminders        TaskReminder[]

  @@index([userId, startAt])
  @@index([status])
  @@index([projectId])
  @@index([phaseId])
  @@index([recurrenceId])
  @@index([isBlueprint])
}

model TaskRecurrence {
  id              String   @id @default(uuid())
  frequency       String   // DAILY, WEEKLY, MONTHLY, YEARLY
  interval        Int      @default(1)
  
  daysOfWeek      String?  // JSON string or comma separated, e.g. "1,3,5" (Mon, Wed, Fri)
  dayOfMonth      Int?
  monthOfYear     Int?
  occurrenceIndex Int?     // e.g. 1 (First), -1 (Last)
  
  startDate       DateTime
  endType         String   // NEVER, ON_DATE, AFTER_OCCURRENCES
  endDate         DateTime?
  occurrenceCount Int?
  
  timezone        String   @default("UTC")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks           Task[]
}

model TaskReminder {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  minutesBefore   Int      // 0 = at start, 15 = 15m before
  channel         String   @default("IN_APP")
  sentAt          DateTime?
  createdAt       DateTime @default(now())
}

// ==========================================
// SETTINGS & LOGS
// ==========================================

model Setting {
  id               String          @id @default(uuid())
  userId           String          @unique
  workStart        String          @default("09:00")
  workEnd          String          @default("17:00")
  dailyGoalHours   Float           @default(8)
  workingDays      String          @default("1,2,3,4,5") // Mon-Fri
  theme            String          @default("dark") // dark, light, system
  accentColor      String          @default("blue")
  reducedMotion    Boolean         @default(false)
  notifications    Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id             String          @id @default(uuid())
  userId         String
  type           String          // Create, Update, Delete
  entity         String          // Category, Project, TimeEntry
  entityId       String
  details        String?
  createdAt      DateTime        @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  targetId  String?
  details   String?  // JSON string
  timestamp DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// TIME OFF & LEAVES
// ==========================================

model TimeOff {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  type      String   // FULL_DAY, HALF_DAY, HOLIDAY
  reason    String?
  status    String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ==========================================
// PROJECT EXTENSIONS (Document Import & Tracking)
// ==========================================

model ProjectPhase {
  id             String          @id @default(uuid())
  projectId      String
  name           String
  description    String?
  goal           String?
  status         String          @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, ON_HOLD
  progress       Float           @default(0)
  startDate      DateTime?
  targetDate     DateTime?
  ownerId        String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  
  tasks          Task[]
  milestones     ProjectMilestone[]
  risks          ProjectRisk[]
  issues         ProjectIssue[]
  decisions      ProjectDecision[]
  dependencies   ProjectDependency[]
  changeLogs     ProjectChangeLog[]

  @@index([projectId])
}

model ProjectMilestone {
  id             String          @id @default(uuid())
  projectId      String
  phaseId        String?
  title          String
  description    String?
  date           DateTime?
  status         String          @default("PENDING") // PENDING, ACHIEVED, MISSED
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ProjectRisk {
  id             String          @id @default(uuid())
  projectId      String
  phaseId        String?
  title          String
  description    String?
  severity       String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String          @default("IDENTIFIED") // IDENTIFIED, MITIGATED, REALIZED
  dueDate        DateTime?
  resolution     String?
  ownerId        String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ProjectIssue {
  id             String          @id @default(uuid())
  projectId      String
  phaseId        String?
  title          String
  description    String?
  severity       String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String          @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  dueDate        DateTime?
  resolution     String?
  ownerId        String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ProjectDecision {
  id             String          @id @default(uuid())
  projectId      String
  phaseId        String?
  title          String
  decision       String
  reason         String?
  date           DateTime?
  ownerId        String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  owner          User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ProjectDependency {
  id             String          @id @default(uuid())
  projectId      String
  phaseId        String?
  description    String
  blocking       Boolean         @default(true)
  blockedBy      String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ProjectChangeLog {
  id             String          @id @default(uuid())
  projectId      String
  phaseId        String?
  taskId         String?
  date           DateTime        @default(now())
  change         String
  description    String?
  reason         String?
  userId         String
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          ProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectDocument {
  id             String          @id @default(uuid())
  projectId      String
  name           String
  type           String          // e.g. "md", "csv"
  size           Int             @default(0)
  content        String          // Storing the raw markdown/text to avoid external buckets for MVP
  url            String?
  uploadedById   String
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy     User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
}

