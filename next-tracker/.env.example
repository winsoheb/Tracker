# PostgreSQL connection string
# Allow NextAuth to accept self-signed SSL internally
NODE_TLS_REJECT_UNAUTHORIZED="0"

DATABASE_URL="postgresql://postgres:secretpassword@db:5432/timetracker?schema=public"

# Application URL
APP_URL="https://192.168.1.176:8443"

# Authentication Config (local, microsoft, both)
AUTH_PROVIDER="both"
ENABLE_LOCAL_AUTH="true"

# NextAuth / Auth.js Secret (Generate one using: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="https://192.168.1.176:8443"

# Microsoft SSO Config
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="https://192.168.1.176:8443/api/auth/callback/azure-ad"
